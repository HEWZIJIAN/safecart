# Required: from Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Required: from `stripe listen` (dev) or Dashboard webhook endpoint (prod)
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Set by scripts/setup-stripe.js
STRIPE_PREMIUM_PRICE_ID=price_REPLACE_ME
STRIPE_FAMILY_PRICE_ID=price_REPLACE_ME

# Where Stripe redirects after Checkout
CHECKOUT_SUCCESS_URL=http://localhost:3001/success.html
CHECKOUT_CANCEL_URL=http://localhost:3001/cancel.html

# Where the user lands after using the billing portal
BILLING_PORTAL_RETURN_URL=http://localhost:3001/success.html

PORT=3001
DB_PATH=./data/safecart.db
