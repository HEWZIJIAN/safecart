# ── Server ──────────────────────────────────────────────────────────────
PORT=8787
# Comma-separated origins allowed to call the API (your site).
ALLOWED_ORIGINS=http://localhost:8787,https://safecart.co
# If you run behind a proxy / load balancer, set the number of hops so the
# rate limiter keys on the REAL client IP (not the proxy). e.g. TRUST_PROXY=1
# TRUST_PROXY=1

# ── Threat provider ─────────────────────────────────────────────────────
# mock | google | virustotal   ("mock" needs no key and runs out of the box)
THREAT_PROVIDER=mock
# GOOGLE_WEB_RISK_API_KEY=your_key_here
# VIRUSTOTAL_API_KEY=your_key_here
# How long to wait on the upstream threat API before failing open (ms).
SCAN_TIMEOUT_MS=4000

# ── Cache (in-memory by default; swap for Redis in prod — see README) ────
CACHE_MAX=5000
CACHE_TTL_SAFE_MS=1800000   # 30 min — safe verdicts can be cached longer
CACHE_TTL_BAD_MS=600000     # 10 min — re-check bad/suspicious sooner

# ── Rate limit (per client IP, fixed window) ────────────────────────────
RATE_WINDOW_MS=60000        # 1 minute window
RATE_MAX=30                 # max scan requests per IP per window
